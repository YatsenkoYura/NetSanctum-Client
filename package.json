{
  "name": "netsanctum-desktop",
  "private": true,
  "version": "2.0.1",
  "description": "Native client and offline runtime for NetSanctum",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YatsenkoYura/netsanctum-desktop.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:android && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync:android": "node scripts/sync-android.mjs",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.56.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
