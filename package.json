{
  "name": "netsanctum-desktop",
  "private": true,
  "version": "2.1.0",
  "description": "Native client and offline runtime for NetSanctum",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YatsenkoYura/netsanctum-desktop.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run sync:android && vite",
    "build": "npm run sync:android && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync:android": "node scripts/sync-android.mjs",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "svelte-check": "4.7.7",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
